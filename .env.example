# 大学生健康管理系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# JWT 密钥（必须修改为随机字符串，建议 32-64 字符）
SECRET_KEY=your-secret-key-here

# 智谱 AI API 密钥（用于 AI 健康分析，可选）
# 申请地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key-here

# ========== 火山引擎 ARK 云端舌诊配置 ==========
# 使用云端豆包视觉模型进行舌象分析，无需本地 YOLO 模型
# 获取方式：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey

# ARK API Key（必填，启用云端分析时需要）
ARK_API_KEY=your-ark-api-key-here

# ARK 模型 ID / 推理接入点 ID（必填）
# 推荐模型：doubao-1-5-vision-pro-32k-250115 （豆包视觉理解）
# 或使用你在 ARK 平台创建的自定义接入点 ID
ARK_MODEL_ID=doubao-seed-1-6-vision-250815
# 前端 URL（用于 CORS 配置，对应 vite 开发端口）
FRONTEND_URL=http://localhost:3000
# 后端服务端口（uvicorn --port，默认 8420）
PORT=8420

# 数据库 URL（可选，默认使用 SQLite）
# PostgreSQL 示例: postgresql://user:password@localhost:5432/health_system
# DATABASE_URL=sqlite:///./health_system.db

# 数据库连接池配置（仅 PostgreSQL 生效）
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Token 过期时间（分钟，可选，默认 30）
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# 邀请码列表（逗号分隔）。未配置则禁止注册（S6：无内置默认码）
INVITE_CODES=health2026
