# 大学生健康管理系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# JWT 密钥（必须修改为随机字符串，建议 32-64 字符）
SECRET_KEY=your-secret-key-here

# AI 模型（供应商 / Base URL / 模型 ID / API Key）在登录后的「AI 设置」页配置，不写入 .env。

# 前端 URL（CORS 主白名单；开发时 Vite 的随机端口已由 allow_origin_regex 自动放行）
FRONTEND_URL=http://localhost:3000
# 后端服务端口（uvicorn --port，默认 8420）
PORT=8420

# 数据库 URL（可选，默认使用 SQLite）
# PostgreSQL 示例: postgresql://user:password@localhost:5432/health_system
# DATABASE_URL=sqlite:///./health_system.db

# 数据库连接池配置（仅 PostgreSQL 生效）
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Token 过期时间（分钟，可选，默认 30）
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# 邀请码列表（逗号分隔）。未配置则禁止注册（S6：无内置默认码）
INVITE_CODES=health2026

# ========== 心理健康支持资源（可选，默认空） ==========
# 心理支持热线：可带 + 前缀，仅数字/空格/括号/连字符，3-41 字符；非法格式整体拒绝
# 未配置时前端仅展示 120/110 + 学校心理咨询中心固定兜底文案，不编造号码
MENTAL_HOTLINE=
# 学校心理咨询中心联系方式：≤300 字，控制字符自动剥离
CAMPUS_COUNSELING=
